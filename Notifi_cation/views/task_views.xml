<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_task_clarification_list" model="ir.ui.view">
        <field name="name">hrms.task.clarification.list</field>
        <field name="model">hrms.task.clarification</field>
        <field name="arch" type="xml">
            <list>
                <field name="employeeId"/>
                <field name="message"/>
                <field name="hrReply"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_task_clarification_form" model="ir.ui.view">
        <field name="name">hrms.task.clarification.form</field>
        <field name="model">hrms.task.clarification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employeeId"/>
                        <field name="message"/>
                        <field name="hrReply"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_task_clarification" model="ir.actions.act_window">
        <field name="name">Task Clarification</field>
        <field name="res_model">hrms.task.clarification</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_hrms_task_clarification"
        name="Task Clarification"
        action="action_task_clarification"
        sequence="20"/>

</odoo>