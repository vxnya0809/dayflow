<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_payroll_list" model="ir.ui.view">
        <field name="name">payroll.list</field>
        <field name="model">payroll</field>
        <field name="arch" type="xml">
            <list>
                <field name="employeeId"/>
                <field name="month"/>
                <field name="basicSalary"/>
                <field name="allowances"/>
                <field name="deductions"/>
                <field name="netSalary"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_payroll_form" model="ir.ui.view">
        <field name="name">payroll.form</field>
        <field name="model">payroll</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employeeId"/>
                        <field name="month"/>
                        <field name="basicSalary"/>
                        <field name="allowances"/>
                        <field name="deductions"/>
                        <field name="netSalary"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_payroll" model="ir.actions.act_window">
        <field name="name">Payroll</field>
        <field name="res_model">payroll</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
